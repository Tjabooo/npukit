[Unit]
Description=npukit gateway (owns the model servers: FastFlowLM on the NPU or llama.cpp/whisper.cpp; unloads them when idle)
Documentation=https://github.com/Tjabooo/npukit
Requires=npud.socket
After=npud.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/npu serve
Restart=on-failure
RestartSec=3
# flm needs to lock its NPU buffers
LimitMEMLOCK=infinity
# the gateway idles in epoll; keep it and its model servers from competing with the desktop:
# under CPU contention (a game) they get half the share of a normal app
Nice=5
CPUWeight=50
TimeoutStopSec=20
KillMode=mixed
